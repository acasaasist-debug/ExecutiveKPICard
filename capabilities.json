  "dataViewMappings": [
    {
      "conditions": [
        {
          "title": { "max": 1 },
          "actualValue": { "min": 1, "max": 1 },
          "previousValue": { "max": 1 },
          "variation": { "max": 1 },
          "target": { "max": 1 },
          "achievement": { "max": 1 },
          "status": { "max": 1 },
          "comparisonPeriod": { "max": 1 },
          "statusColor": { "max": 1 },
          "variationColor": { "max": 1 },
          "trendIcon": { "max": 1 }
        }
      ],
      "table": {
        "rows": {
          "select": [
            { "for": { "in": "title" } },
            { "for": { "in": "actualValue" } },
            { "for": { "in": "previousValue" } },
            { "for": { "in": "variation" } },
            { "for": { "in": "target" } },
            { "for": { "in": "achievement" } },
            { "for": { "in": "status" } },
            { "for": { "in": "comparisonPeriod" } },
            { "for": { "in": "statusColor" } },
            { "for": { "in": "variationColor" } },
            { "for": { "in": "trendIcon" } }
          ]
        }
      }
    }
